---
// Single author. Kim was removed 2026-10-08: no evidence in the repo, memory or shared facts that she
// is a credentialed author who agreed to be named, and her author page never existed (it returned 404).
// The avatar was an Unsplash stock portrait. It is removed (monogram instead) until Tim supplies a
// real portrait: set `avatar` to a local /images/... path then. tests/authors.test.mjs enforces this.
interface Props {
  author: 'tim';
  visitDate?: string;
  context?: string;
}
const { author, visitDate, context } = Astro.props;

const authors = {
  tim: {
    name: 'Tim Hennig',
    initials: 'TH',
    role: 'East Africa · GM, Boutique Hotel Matlai, Zanzibar',
    bio: 'I have lived on Zanzibar since 2011 and am General Manager of Boutique Hotel Matlai. Every Beyond Paradise Adventures review is based on a paid, first-hand stay. I disclose my conflict of interest: I never review Matlai.',
    avatar: null as string | null,
    link: '/about/',
    accent: 'var(--gold)',
  },
};

const a = authors[author];
---
<aside class="author-block glass reveal" aria-label={`About the author: ${a.name}`}>
  {a.avatar
    ? <img src={a.avatar} alt={`${a.name}, Beyond Paradise Adventures author`} class="author-block__avatar" width="64" height="64" loading="lazy" />
    : <div class="author-block__avatar author-block__avatar--monogram" aria-hidden="true">{a.initials}</div>}
  <div class="author-block__body">
    <p class="author-block__name" style={`color:${a.accent}`}><a href={a.link}>{a.name}</a></p>
    <p class="author-block__role">{a.role}</p>
    <p class="author-block__bio">{a.bio}</p>
    {visitDate && <p class="author-block__visit">Reviewed: <time>{visitDate}</time></p>}
    {context && <p class="author-block__context">{context}</p>}
  </div>
</aside>

<style>
.author-block {
  display: flex;
  gap: 20px;
  align-items: flex-start;
  border-radius: 16px;
  padding: 28px 32px;
  margin: 48px 0;
}
.author-block__avatar {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  object-fit: cover;
  flex-shrink: 0;
  border: 2px solid var(--glass-b);
}
.author-block__avatar--monogram {
  display: flex; align-items: center; justify-content: center;
  font-family: 'Playfair Display', Georgia, serif; font-size: 20px; color: var(--gold);
}
.author-block__name a { color: inherit; text-decoration: none; }
.author-block__name {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 18px;
  margin-bottom: 2px;
}
.author-block__role {
  font-size: 11px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--cream-38);
  margin-bottom: 10px;
}
.author-block__bio {
  font-size: 14px;
  color: var(--cream-65);
  line-height: 1.65;
  margin-bottom: 8px;
}
.author-block__visit {
  font-size: 12px;
  color: var(--cream-38);
}
.author-block__context {
  font-size: 13px;
  color: var(--gold);
  font-style: italic;
  margin-top: 8px;
}
@media (max-width: 600px) {
  .author-block { flex-direction: column; padding: 20px; }
}
</style>
