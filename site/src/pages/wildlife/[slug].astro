---
import { getCollection } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import RelatedExcursions from '../../components/RelatedExcursions.astro';

const SPECIES_TOURS: Record<string, string[]> = {
  'whale-shark': ['mafia-whale-shark-snorkelling', 'mafia-marine-park-diving'],
  'green-sea-turtle': ['mnemba-atoll-snorkeling'],
  'indo-pacific-bottlenose-dolphin': ['safari-blue-menai-bay'],
};

export async function getStaticPaths() {
  const guides = await getCollection('wildlife', ({ data }) => !data.draft);
  return guides.map(g => ({ params: { slug: g.slug }, props: { guide: g } }));
}

const { guide } = Astro.props;
const { Content } = await guide.render();
const d = guide.data;
---
<ArticleLayout
  title={d.title}
  description={d.description}
  permalink={d.permalink}
  heroImage={d.hero_image}
  heroAlt={d.hero_alt}
  author={d.author}
  lastUpdated={d.last_updated}
  answer={d.answer}
  faq={d.faq}
  schemaType="Article"
  schemaExtra={{
    about: {
      '@type': 'Taxon',
      name: d.common_name,
      scientificName: d.scientific_name,
    },
    contentLocation: { '@type': 'Place', name: d.region },
  }}
>
  <Content />
  <RelatedExcursions tourIds={SPECIES_TOURS[d.species_id] ?? []} heading={SPECIES_TOURS[d.species_id] ? 'Trips that put you in the water' : 'Keep planning'} />
</ArticleLayout>
