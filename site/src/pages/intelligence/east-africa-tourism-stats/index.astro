---
import Base from '../../../layouts/Base.astro';
import { resolvedGroups, lastVerified, firstVerified } from '../../../lib/facts-stats';

const groups = resolvedGroups();
const verified = lastVerified();
const oldest = firstVerified();
const fmt = (d: string) => new Date(d + 'T00:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const verifiedLong = fmt(verified);
const oldestLong = fmt(oldest);
const URL_ = 'https://beyondparadiseadventures.com/intelligence/east-africa-tourism-stats/';
const CSV_URL = URL_ + 'east-africa-tourism-stats.csv';
const statCount = groups.reduce((n, g) => n + g.stats.length, 0);

const pick = (label: string) => {
  const hit = groups.flatMap(g => g.stats).find(s => s.label.startsWith(label));
  if (!hit) throw new Error('key figure not found: ' + label);
  return hit;
};
const keyFigures = [
  { stat: pick('Documented individuals, December 2019'), text: 'whale sharks documented at Mafia Island, up from about 100 in 2012' },
  { stat: pick('Mountain gorillas'), text: 'mountain gorillas worldwide (2018 census)' },
  { stat: pick('Black rhinos, Kenya'), text: 'black rhinos in Kenya by 2024' },
  { stat: pick('AI satellite count, August 2023'), text: 'wildebeest counted by Oxford satellite survey in August 2023, against a long-standing estimate of 1.3 to 1.5 million' },
  { stat: pick('Serengeti and Nyerere'), text: 'conservation fee per non-East African adult in Serengeti and Nyerere (2023/24 tariff)' },
];

const allSources = new Map<string, string>();
for (const g of groups) for (const s of g.stats) for (const src of s.fact.sources) allSources.set(src.url, src.name);

const dataset = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'East Africa wildlife and travel statistics (sourced)',
  description: 'Confirmed, multi-source statistics on Great Migration wildebeest numbers, Mafia Island whale sharks, East African wildlife populations and Tanzania and Zanzibar entry and park costs, each with source URLs and verification dates.',
  url: URL_,
  isAccessibleForFree: true,
  inLanguage: 'en',
  dateModified: verified,
  keywords: ['East Africa', 'Tanzania', 'Zanzibar', 'Kenya', 'Great Migration', 'whale sharks', 'safari costs', 'wildlife populations'],
  spatialCoverage: { '@type': 'Place', name: 'East Africa (Tanzania, Kenya, Rwanda, Zanzibar)' },
  creator: { '@type': 'Organization', name: 'Beyond Paradise Adventures', url: 'https://beyondparadiseadventures.com', sameAs: ['https://www.wikidata.org/wiki/Q140420385'] },
  variableMeasured: groups.flatMap(g => g.stats.map(s => s.label)),
  distribution: [{ '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: CSV_URL }],
  citation: [...allSources.keys()],
};

// Simple SVG bar charts, generated at build time from the same resolved stats.
function chart(g: (typeof groups)[number]) {
  const rows = g.stats.filter(s => s.chart);
  if (!rows.length) return null;
  const max = Math.max(...rows.map(r => r.chart!.to)) * 1.08;
  const W = 720, labelW = 270, barH = 22, gap = 14, top = 8, valueRoom = 150;
  const H = top + rows.length * (barH + gap);
  const x = (v: number) => (v / max) * (W - labelW - valueRoom);
  const bars = rows.map((r, i) => {
    const single = r.chart!.from === r.chart!.to;
    const start = single ? 0 : x(r.chart!.from);
    return {
      y: top + i * (barH + gap),
      x0: labelW + start,
      w: Math.max(4, x(r.chart!.to) - start),
      label: r.label.length > 40 ? r.label.slice(0, 38) + '.' : r.label,
      display: r.display,
    };
  });
  return { W, H, labelW, barH, bars, desc: rows.map(r => `${r.label}: ${r.display}`).join('; ') };
}
---
<Base
  title="East Africa Tourism Statistics: Wildlife, Parks, Costs"
  description="Sourced East Africa statistics: Great Migration counts, Mafia whale sharks, wildlife populations and Tanzania entry and park costs. Free CSV download."
>
  <script type="application/ld+json" set:html={JSON.stringify(dataset)} slot="head" />

  <div class="stats-page">
    <div class="stats-hero section--dark">
      <div class="container">
        <p class="label reveal">ORIGINAL DATA</p>
        <h1 class="display-l reveal" style="margin-top:16px;max-width:820px;">East Africa Tourism Statistics: Wildlife, Parks and Costs</h1>
        <p class="body-l reveal" style="color:var(--cream-65);margin-top:20px;max-width:680px;">
          Every number on this page is a confirmed fact from our database, backed by at least two independent sources.
          Last verified <strong>{verifiedLong}</strong>. Free to cite with a link back.
        </p>
        <div class="stats-hero__actions reveal">
          <a class="btn btn-gold" href="east-africa-tourism-stats.csv" download>Download CSV ({statCount} statistics)</a>
          <a class="btn btn-glass" href="/intelligence/migration-calendar/">Migration calendar</a>
        </div>
      </div>
    </div>

    <div class="container stats-body">
      <section class="stats-key glass reveal" aria-label="Key figures">
        <h2 class="display-s">Key figures at a glance</h2>
        <ul class="stats-key__list">
          {keyFigures.map(k => <li><strong>{k.stat.display}</strong> {k.text}</li>)}
        </ul>
      </section>

      {groups.map(g => {
        const c = chart(g);
        return (
          <section class="stats-section reveal" id={g.id}>
            <h2 class="display-s">{g.heading}</h2>
            <p class="stats-lead">{g.lead}</p>

            <div class="stats-table-wrap">
              <table class="stats-table">
                <caption class="sr-only">{g.heading}</caption>
                <thead><tr><th scope="col">Statistic</th><th scope="col">Value</th><th scope="col">Context</th><th scope="col">Sources (last checked)</th></tr></thead>
                <tbody>
                  {g.stats.map(s => (
                    <tr>
                      <th scope="row">{s.label}</th>
                      <td class="stats-table__num">{s.display}</td>
                      <td>{s.context}</td>
                      <td class="stats-table__src">
                        {s.fact.sources.slice(0, 3).map(src => <a href={src.url} rel="noopener" target="_blank">{src.name}</a>)}
                        <time datetime={s.fact.verified}>{s.fact.verified}</time>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            {c && (
              <figure class="stats-chart">
                <svg viewBox={`0 0 ${c.W} ${c.H}`} role="img" aria-labelledby={`t-${g.id} d-${g.id}`} width="100%">
                  <title id={`t-${g.id}`}>{g.heading}</title>
                  <desc id={`d-${g.id}`}>{c.desc}</desc>
                  {c.bars.map(b => (
                    <g>
                      <text x={c.labelW - 12} y={b.y + c.barH / 2 + 4} text-anchor="end" class="chart-label">{b.label}</text>
                      <rect x={b.x0} y={b.y} width={b.w} height={c.barH} rx="3" class="chart-bar" />
                      <text x={b.x0 + b.w + 8} y={b.y + c.barH / 2 + 4} class="chart-value">{b.display}</text>
                    </g>
                  ))}
                </svg>
                <figcaption>Unit: {g.chartUnit}. Bars span the reported range, drawn from zero where a single figure is given. Sources are in the table above.</figcaption>
              </figure>
            )}
          </section>
        );
      })}

      <section class="stats-section reveal" id="arrivals">
        <h2 class="display-s">How many tourists visit Tanzania and Kenya each year?</h2>
        <p class="stats-lead">This page does not yet publish national tourist-arrival or tourism-revenue totals. We list a figure only when two independent sources confirm it, and arrivals and revenue are not in our confirmed database yet. Until they are, use the national statistics offices directly: Tanzania's National Bureau of Statistics, the Zanzibar Office of the Chief Government Statistician, and Kenya's Tourism Research Institute.</p>
      </section>

      <section class="stats-section reveal" id="method">
        <h2 class="display-s">Methodology and refresh schedule</h2>
        <ul class="stats-method">
          <li><strong>Inclusion rule:</strong> a statistic appears only if its fact has status "confirmed" in our database, meaning two or more independent sources. Single-source figures are excluded.</li>
          <li><strong>Last verified:</strong> source access dates run from {oldestLong} to {verifiedLong}. Each row shows its own date.</li>
          <li><strong>Refresh:</strong> reviewed quarterly. The page, the CSV and the dataset metadata are regenerated from the fact database at every site build, so a re-verified fact updates all three at once.</li>
          <li><strong>Disputed numbers:</strong> where sources disagree, as with the Serengeti wildebeest population, both figures are shown with their methods.</li>
          <li><strong>Citing:</strong> please cite as "Beyond Paradise Adventures, East Africa Tourism Statistics, {verifiedLong}" and link to this page. Data download: <a href="east-africa-tourism-stats.csv" download>CSV</a>.</li>
          <li><strong>Independence:</strong> no operator or lodge pays for inclusion. See the <a href="/about/editorial-policy/">editorial policy</a>.</li>
        </ul>
      </section>

      <section class="stats-section reveal" id="more">
        <h2 class="display-s">Go deeper</h2>
        <div class="stats-links">
          <a href="/wildlife/great-migration-serengeti-masai-mara/" class="btn btn-glass">Great Migration month by month</a>
          <a href="/wildlife/whale-sharks-mafia-island/" class="btn btn-glass">Whale sharks at Mafia Island</a>
          <a href="/east-africa/serengeti/" class="btn btn-glass">Serengeti safari guide</a>
          <a href="/east-africa/zanzibar/" class="btn btn-glass">Zanzibar travel guide</a>
          <a href="/excursions/" class="btn btn-glass">Zanzibar and Mafia day trips</a>
        </div>
      </section>
    </div>
  </div>
</Base>

<style>
.stats-hero { padding: 140px 0 72px; }
.stats-hero__actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
.stats-body { padding: 56px 0 120px; max-width: 1000px; }
.stats-key { border-radius: 20px; padding: 28px 32px; margin-bottom: 56px; }
.stats-key__list { padding-left: 20px; margin-top: 16px; color: var(--cream-65); line-height: 1.7; }
.stats-key__list strong { color: var(--gold); font-weight: 600; }
.stats-section { margin-bottom: 64px; }
.stats-section h2 { margin-bottom: 12px; }
.stats-lead { color: var(--cream-65); line-height: 1.75; margin-bottom: 24px; max-width: 760px; }
.stats-table-wrap { overflow-x: auto; }
.stats-table { width: 100%; border-collapse: collapse; font-size: 14px; }
.stats-table th, .stats-table td { text-align: left; padding: 12px 14px; border-bottom: 1px solid var(--glass-b); vertical-align: top; color: var(--cream-65); }
.stats-table thead th { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--cream-38); font-weight: 600; }
.stats-table tbody th { color: var(--cream); font-weight: 500; }
.stats-table .stats-table__num { color: var(--gold); font-weight: 600; white-space: nowrap; }
.stats-table__src { display: flex; flex-direction: column; gap: 4px; font-size: 12px; }
.stats-table__src a { color: var(--teal-l); text-decoration: underline; text-decoration-color: rgba(74,171,184,0.4); }
.stats-table__src time { color: var(--cream-38); }
.stats-chart { margin: 28px 0 0; }
.stats-chart figcaption { font-size: 12px; color: var(--cream-38); margin-top: 8px; }
.chart-bar { fill: var(--gold); }
.chart-label { fill: rgba(245,240,232,0.65); font-size: 12px; }
.chart-value { fill: #F5F0E8; font-size: 12px; font-weight: 600; }
.stats-method { padding-left: 20px; color: var(--cream-65); line-height: 1.75; }
.stats-method li { margin-bottom: 10px; }
.stats-method a { color: var(--gold); text-decoration: underline; }
.stats-links { display: flex; gap: 12px; flex-wrap: wrap; }
.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
