---
import { getCollection } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import RelatedExcursions from '../../components/RelatedExcursions.astro';

const DEST_TOURS: Record<string, string[]> = {
  zanzibar: ['stone-town-spice-tour', 'mnemba-atoll-snorkeling', 'safari-blue-menai-bay'],
  'mafia-island': ['mafia-whale-shark-snorkelling', 'mafia-marine-park-diving'],
};

export async function getStaticPaths() {
  const guides = await getCollection('destinations', ({ data }) => !data.draft);
  return guides.map(g => ({ params: { slug: g.slug }, props: { guide: g } }));
}

const { guide } = Astro.props;
const { Content } = await guide.render();
const d = guide.data;
---
<ArticleLayout
  title={d.title}
  description={d.description}
  permalink={d.permalink}
  heroImage={d.hero_image}
  heroAlt={d.hero_alt}
  author={d.author}
  lastUpdated={d.last_updated}
  answer={d.answer}
  faq={d.faq}
  schemaType="Article"
  schemaExtra={{
    contentLocation: { '@type': 'Place', name: d.region },
  }}
>
  <Content />
  <RelatedExcursions tourIds={DEST_TOURS[d.destination_id] ?? []} heading={DEST_TOURS[d.destination_id] ? `Day trips from ${d.destination_id === 'zanzibar' ? 'Zanzibar' : 'Mafia Island'}` : 'Keep planning'} />
</ArticleLayout>
